{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowbility.org/know-qa-agent/run-manifest.schema.json",
  "title": "know-qa-agent run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "project",
    "sources",
    "selection",
    "environment",
    "scenarios",
    "cells",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "selection": {
      "type": "object",
      "required": ["specs", "tags", "areas", "owner", "auto_included_dependencies"],
      "properties": {
        "specs": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "areas": { "type": "array", "items": { "type": "string" } },
        "owner": { "type": ["string", "null"] },
        "auto_included_dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["name", "base_url", "credentials_present"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "base_url": { "type": "string", "minLength": 1 },
        "credentials_present": { "type": "boolean" },
        "timeouts": { "type": "object" },
        "flags": { "type": "object" }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "spec", "tags", "depends_on", "area", "owner", "implementation_status", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "spec": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "area": { "type": ["string", "null"] },
          "owner": { "type": ["string", "null"] },
          "implementation_status": { "enum": ["implemented", "not-implemented"] },
          "status": { "enum": ["pending", "running", "passed", "failed", "blocked", "skipped", "incomplete"] }
        },
        "additionalProperties": false
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario_id",
          "browser",
          "cli_browser",
          "viewport",
          "persona",
          "data_variant",
          "status",
          "result_path"
        ],
        "properties": {
          "id": { "type": "string" },
          "scenario_id": { "type": "string" },
          "browser": { "enum": ["chromium", "firefox", "webkit"] },
          "cli_browser": { "enum": ["chrome", "firefox", "webkit"] },
          "viewport": {
            "type": "object",
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "persona": { "type": "string" },
          "data_variant": { "type": ["string", "null"] },
          "status": { "enum": ["pending", "running", "passed", "failed", "blocked", "skipped", "incomplete"] },
          "result_path": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_policy": {
      "type": "object",
      "required": ["raw_restricted", "sanitized_text_only", "screenshots_require_review"],
      "properties": {
        "raw_restricted": { "const": true },
        "sanitized_text_only": { "const": true },
        "screenshots_require_review": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
